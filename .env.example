# Server
PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chat_demo

# Firebase Admin (Firestore)
# Path to the service-account JSON downloaded from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json
FIREBASE_PROJECT_ID=your-firebase-project-id
